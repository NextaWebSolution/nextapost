# NextaPost configuration. The web installer (/install) creates .env for you.
APP_NAME="NextaPost"
APP_URL="https://social.yourdomain.com"
APP_KEY=""                      # base64:… 32 random bytes — generated by the installer. Never change after install.
APP_DEBUG="false"

DB_DRIVER="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="cpaneluser_nextapost"
DB_USER="cpaneluser_nextapost"
DB_PASS=""

MAX_UPLOAD_MB="100"
MAX_WORKSPACE_STORAGE_MB="10240"   # per-workspace storage allowance
SESSION_IDLE_HOURS="12"            # sign out after this much inactivity
SESSION_MAX_DAYS="7"               # always sign in again after this many days
RATE_LIMIT_WRITES="300"            # max form/API writes per user per 5 minutes

# Optional overrides
# META_GRAPH_VERSION="v21.0"
# LINKEDIN_VERSION="202510"
# UPDATE_SERVER="https://updates.nextawebsolution.com"
# UPDATE_PUBLIC_KEY=""
