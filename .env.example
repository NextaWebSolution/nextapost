# NextaPost configuration. The web installer (/install) creates .env for you.
APP_NAME="NextaPost"
APP_URL="https://social.yourdomain.com"
APP_KEY=""                      # base64:… 32 random bytes — generated by the installer. Never change after install.
APP_DEBUG="false"

DB_DRIVER="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="cpaneluser_nextapost"
DB_USER="cpaneluser_nextapost"
DB_PASS=""

MAX_UPLOAD_MB="100"
MAX_WORKSPACE_STORAGE_MB="10240"   # per-workspace storage allowance
SESSION_IDLE_HOURS="12"            # sign out after this much inactivity
SESSION_MAX_DAYS="7"               # always sign in again after this many days
RATE_LIMIT_WRITES="300"            # max form/API writes per user per 5 minutes

# Optional overrides
# META_GRAPH_VERSION="v21.0"
# LINKEDIN_VERSION="202510"
# UPDATE_SERVER="https://updates.nextawebsolution.com"
# UPDATE_PUBLIC_KEY=""

# ── NextaPost 2.0 (all optional) ──────────────────────────────────────────────
# Requests per minute for each API key or connected AI app (REST API and MCP).
# API_RATE_LIMIT=120
# AI writing-assistant requests per person per hour.
# AI_RATE_LIMIT=60
# AI translation batches per admin per hour (System → Languages).
# AI_TRANSLATE_RATE_LIMIT=400
# Extra browser origins allowed to call /mcp, comma-separated (AI desktop apps don't need this).
# MCP_ALLOWED_ORIGINS=https://app.example.com
# Allow an OpenAI-compatible AI server on a private network (e.g. a local model). Leave off on shared hosting.
# AI_ALLOW_PRIVATE_BASE_URL=0

# Comment-to-DM flows (turned on in System → General): private replies per hour per account. Meta allows 750.
# DM_PRIVATE_REPLIES_PER_HOUR=700
# Post pins to Pinterest's sandbox while your app only has Trial access.
# PINTEREST_SANDBOX=0
# SQLite file (development and tests only; production uses MySQL).
# DB_PATH=storage/database.sqlite
